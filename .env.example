# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Collection went through OpenRouter. The harness accepts the key under either
# name (see ppa/env_loader.py); OPENROUTER_API_KEY is preferred.
OPENROUTER_API_KEY=

# Legacy alias, still honoured as a fallback.
# OPENAI_API_KEY=
